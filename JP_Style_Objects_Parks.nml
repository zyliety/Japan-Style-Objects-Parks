//select correct sprites for position of the tiles for the one view
switch (FEAT_OBJECTS, SELF, switch_pa_7_position_view1, relative_pos) {
	relative_coord(0, 0): spritelayout_pa_7_t1_view1;
	relative_coord(0, 1): spritelayout_pa_7_t2_view1;
	relative_coord(0, 2): spritelayout_pa_7_t3_view1;
	relative_coord(0, 3): spritelayout_pa_7_t4_view1;
        relative_coord(1, 0): spritelayout_pa_7_t5_view1;
	relative_coord(1, 1): spritelayout_pa_7_t6_view1;
	relative_coord(1, 2): spritelayout_pa_7_t7_view1;
	relative_coord(1, 3): spritelayout_pa_7_t8_view1;
	relative_coord(2, 0): spritelayout_pa_7_t9_view1;
	relative_coord(2, 1): spritelayout_pa_7_t10_view1;
	relative_coord(2, 2): spritelayout_pa_7_t11_view1;
	relative_coord(2, 3): spritelayout_pa_7_t12_view1;
	relative_coord(3, 0): spritelayout_pa_7_t13_view1;
	relative_coord(3, 1): spritelayout_pa_7_t14_view1;
	relative_coord(3, 2): spritelayout_pa_7_t15_view1;
	relative_coord(3, 3): spritelayout_pa_7_t16_view1;
	spritelayout_pa_7_t1_view1;
    }

