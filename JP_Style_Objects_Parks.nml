//OBJECT 1 SIMPLE tallmultipic//
//SPRITELAYOUTS//

//RURAL tallmultipic LOT NE + PURCHASE//
spritelayout spritelayout_bt_10_1 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_bt_10_1((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_bt_10_1_snow((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }


}

spritelayout spritelayout_bt_10_1_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_bt_10_PURCHASE(0);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

