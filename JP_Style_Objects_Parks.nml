//select correct sprites for position of the tiles for the four views
switch (FEAT_OBJECTS, SELF, switch_pa_3_position_view1, relative_pos) {
	relative_coord(0, 0): spritelayout_pa_3_t1_view1;
	relative_coord(1, 0): spritelayout_pa_3_t2_view1;

    spritelayout_pa_3_t1_view1;
    }

switch (FEAT_OBJECTS, SELF, switch_pa_3_position_view2, relative_pos) {
	relative_coord(0, 0): spritelayout_pa_3_t1_view2;
	relative_coord(0, 1): spritelayout_pa_3_t2_view2;

    spritelayout_pa_3_t1_view2;
    }

switch (FEAT_OBJECTS, SELF, switch_pa_3_position_view3, relative_pos) {
	relative_coord(0, 0): spritelayout_pa_3_t1_view3;
	relative_coord(1, 0): spritelayout_pa_3_t2_view3;

    spritelayout_pa_3_t1_view3;
    }

switch (FEAT_OBJECTS, SELF, switch_pa_3_position_view4, relative_pos) {
	relative_coord(0, 0) : spritelayout_pa_3_t1_view4;
	relative_coord(0, 1) : spritelayout_pa_3_t2_view4;

    spritelayout_pa_3_t1_view4;
    }
 
//decide spritelayout for each of the 4 directions
switch (FEAT_OBJECTS, SELF, switch_pa_3_view, view) {
    1:  switch_pa_3_position_view2;
    2:  switch_pa_3_position_view3;
    3:  switch_pa_3_position_view4;
    switch_pa_3_position_view1;
}


//calculate ground sprite for object
switch (FEAT_OBJECTS, SELF, switch_pa_3_object, [
    STORE_TEMP(GROUNDSPRITE_NORMAL, 1),
    STORE_TEMP( (nearby_tile_terrain_type(0,0) == TILETYPE_DESERT) * GROUNDSPRITE_DESERT, 1),
    STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 1, 0) == TILETYPE_DESERT), 1),
    STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type(-1, 0) == TILETYPE_DESERT), 1),
    STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 0, 1) == TILETYPE_DESERT), 1),
    STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 0,-1) == TILETYPE_DESERT), 1),
    STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * GROUNDSPRITE_NORMAL, 1),
    STORE_TEMP(terrain_type == TILETYPE_SNOW   ? GROUNDSPRITE_SNOW : LOAD_TEMP(1), 1),
    STORE_TEMP(snowline_height == 0xFF ? 0xFF : nearby_tile_height(0,0) - snowline_height, 127),
    STORE_TEMP((LOAD_TEMP(127) == -1) ? GROUNDSPRITE_SNOW_1_4 : LOAD_TEMP(1), 1),
    STORE_TEMP((LOAD_TEMP(127) ==  0) ? GROUNDSPRITE_SNOW_2_4 : LOAD_TEMP(1), 1),
    STORE_TEMP((LOAD_TEMP(127) ==  1) ? GROUNDSPRITE_SNOW_3_4 : LOAD_TEMP(1), 1)
        ]) {
    switch_pa_3_view;
}

//calculate ground sprite for purchase menu
switch (FEAT_OBJECTS, SELF, switch_pa_3_purchase, view) {
    1:  spritelayout_pa_3_view2_purchase;
    2:  spritelayout_pa_3_view3_purchase;
    3:  spritelayout_pa_3_view4_purchase;
    spritelayout_pa_3_view1_purchase;
}

item (FEAT_OBJECTS, pa_3, 103) {
    property {
        class: "PARR";
        classname: string(STR_PARR);
        name: string(STR_pa_3);
        climates_available: ALL_CLIMATES;
        size: [2,1];
        build_cost_multiplier: 1;
        remove_cost_multiplier: 4;
        introduction_date: date(1700,1,1);
        end_of_life_date: 0xFFFFFFFF;
        object_flags: bitmask(OBJ_FLAG_ALLOW_BRIDGE, OBJ_FLAG_ANYTHING_REMOVE, OBJ_FLAG_REMOVE_IS_INCOME);
        height: 0;
        num_views: 4;
     }
    graphics {
        default: switch_pa_3_object;
        purchase: switch_pa_3_purchase;

      }
}
