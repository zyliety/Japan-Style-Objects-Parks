        end_of_life_date: 0xFFFFFFFF;
        object_flags: bitmask(OBJ_FLAG_ANYTHING_REMOVE, OBJ_FLAG_REMOVE_IS_INCOME);
        height: 2;
        num_views: 4;
     }
    graphics {
        default: switch_bt_5_object;
        purchase: switch_bt_5_purchase;
        autoslope: return CB_RESULT_AUTOSLOPE;

      }
}
