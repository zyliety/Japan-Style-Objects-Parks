	}

	building {
        sprite: spriteset_path_2_4((animation_frame + nearby_tile_random_bits(0,0)) % 5);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
