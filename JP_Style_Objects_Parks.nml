//RURAL tallmultipic LOT NE + PURCHASE//
spritelayout spritelayout_bt_11_1 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_bt_11_1((animation_frame + nearby_tile_random_bits(0,0)) % 7);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_bt_11_1_snow((animation_frame + nearby_tile_random_bits(0,0)) % 7);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }


}

