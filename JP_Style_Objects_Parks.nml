//OBJECT 1 SIMPLE tallmultipic//
//SPRITELAYOUTS//

//RURAL tallmultipic LOT NE + PURCHASE//
spritelayout spritelayout_path_2_1 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_2_1((animation_frame + nearby_tile_random_bits(0,0)) % 2);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_2_1_snow((animation_frame + nearby_tile_random_bits(0,0)) % 2);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }


}

spritelayout spritelayout_path_2_1_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_2_PURCHASE(0);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//RURAL tallmultipic LOT SE + PURCHASE//
spritelayout spritelayout_path_2_2 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_2_2((animation_frame + nearby_tile_random_bits(0,0)) % 2);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_2_2_snow((animation_frame + nearby_tile_random_bits(0,0)) % 2);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }

}
spritelayout spritelayout_path_2_2_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_2_PURCHASE(1);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//OBJECT 2 SIMPLE tallmultipic//
//tallmultipic LOT NE + PURCHASE//
spritelayout spritelayout_path_2_3 {
