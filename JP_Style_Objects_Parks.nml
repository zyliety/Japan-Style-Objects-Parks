//OBJECT 2 SIMPLE tallmultipic//
//tallmultipic LOT NE + PURCHASE//
spritelayout spritelayout_path_6_3 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_6_3((animation_frame + nearby_tile_random_bits(0,0)) % 8);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_6_3_snow((animation_frame + nearby_tile_random_bits(0,0)) % 8);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }

}
spritelayout spritelayout_path_6_3_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_6_PURCHASE(2);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//tallmultipic LOT SE + PURCHASE//
spritelayout spritelayout_path_6_4 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_6_4((animation_frame + nearby_tile_random_bits(0,0)) % 9);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_6_4_snow((animation_frame + nearby_tile_random_bits(0,0)) % 9);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }

}
spritelayout spritelayout_path_6_4_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_6_PURCHASE(3);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//decide spritelayout for each of the 4 views
switch (FEAT_OBJECTS, SELF, switch_path_6_view, view) {
    1:  spritelayout_path_6_2;
    2:  spritelayout_path_6_3;
    3:  spritelayout_path_6_4;
    spritelayout_path_6_1;
}

//calculate ground sprite for object
switch (FEAT_OBJECTS, SELF, switch_path_6_object, [
        //tile slope offset in storage register 0
        STORE_TEMP(0, 0),
        //terrain type in storage register 1
        STORE_TEMP(GROUNDSPRITE_NORMAL, 1),
		STORE_TEMP( (nearby_tile_terrain_type(0,0) == TILETYPE_DESERT) * GROUNDSPRITE_DESERT, 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 1, 0) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type(-1, 0) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 0, 1) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 0,-1) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * GROUNDSPRITE_NORMAL, 1),
		STORE_TEMP(terrain_type == TILETYPE_SNOW   ? GROUNDSPRITE_SNOW : LOAD_TEMP(1), 1),
		STORE_TEMP(snowline_height == 0xFF ? 0xFF : nearby_tile_height(0,0) - snowline_height, 127),
		STORE_TEMP((LOAD_TEMP(127) == -1) ? GROUNDSPRITE_SNOW_1_4 : LOAD_TEMP(1), 1),
		STORE_TEMP((LOAD_TEMP(127) ==  0) ? GROUNDSPRITE_SNOW_2_4 : LOAD_TEMP(1), 1),
		STORE_TEMP((LOAD_TEMP(127) ==  1) ? GROUNDSPRITE_SNOW_3_4 : LOAD_TEMP(1), 1)
        ]) {
    switch_path_6_view;
}

//decide spritelayout for the purchase menu
switch (FEAT_OBJECTS, SELF, switch_path_6_purchase, view) {
    1:  spritelayout_path_6_2_purchase;
    2:  spritelayout_path_6_3_purchase;
    3:  spritelayout_path_6_4_purchase;
    spritelayout_path_6_1_purchase;
}

switch (FEAT_OBJECTS, SELF, switch_add_text_STR_path_6, view) {
1: string(STR_path_6_purchase_view2);
2: string(STR_path_6_purchase_view3);
3: string(STR_path_6_purchase_view4);
default: string(STR_path_6_purchase_view1);
}

item (FEAT_OBJECTS, item_path_6, 206) {
    property {
        class:                  "PAHH";
	classname:		string(STR_PAHH);
        name:                   string(STR_path_6);
        climates_available:     ALL_CLIMATES;
        size:                   [1,1];
        build_cost_multiplier:  0;
        remove_cost_multiplier: 0;
        introduction_date:      date(1111,1,1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           bitmask(OBJ_FLAG_ANYTHING_REMOVE);
//	animation_info:			[ANIMATION_LOOPING, 9];
//	animation_speed:		7;
//	animation_triggers:		3;
        height:                 1;
        num_views:              4;
    }
    graphics {
        default:            switch_path_6_object;
        purchase:           switch_path_6_purchase;
        autoslope:          return(CB_RESULT_AUTOSLOPE);
//      additional_text:    string(STR_tallmultipic_1_PURCHASE);
        additional_text:    switch_add_text_STR_path_6;
	anim_control:    	return CB_RESULT_NEXT_FRAME;
	anim_next_frame: 	return CB_RESULT_NEXT_FRAME;
    }
}
