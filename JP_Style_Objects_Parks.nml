        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_3_PURCHASE(2);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//tallmultipic LOT SE + PURCHASE//
spritelayout spritelayout_path_3_4 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_3_4((animation_frame + nearby_tile_random_bits(0,0)) % 8);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
