		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_5_2_snow((animation_frame + nearby_tile_random_bits(0,0)) % 3);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
