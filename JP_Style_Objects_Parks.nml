        autoslope:          return(CB_RESULT_AUTOSLOPE);
//      additional_text:    string(STR_path_8_1_PURCHASE);
        additional_text:    switch_add_text_STR_path_8;
	anim_control:    	return CB_RESULT_NEXT_FRAME;
