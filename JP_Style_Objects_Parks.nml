    3:  spritelayout_bt_4_4_purchase;
    spritelayout_bt_4_1_purchase;
}

switch (FEAT_OBJECTS, SELF, switch_add_text_STR_bt_4, view) {
1: string(STR_bt_4_purchase_view2);
2: string(STR_bt_4_purchase_view3);
3: string(STR_bt_4_purchase_view4);
default: string(STR_bt_4_purchase_view1);
}

item (FEAT_OBJECTS, item_bt_4, 004) {
    property {
        class:                  "BATS";
	classname:		string(STR_BATS);
        name:                   string(STR_bt_4);
        climates_available:     ALL_CLIMATES;
        size:                   [1,1];
        build_cost_multiplier:  0;
        remove_cost_multiplier: 0;
        introduction_date:      date(1111,1,1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           bitmask(OBJ_FLAG_ANYTHING_REMOVE);
//	animation_info:			[ANIMATION_LOOPING, 9];
//	animation_speed:		7;
//	animation_triggers:		3;
        height:                 1;
        num_views:              4;
    }
    graphics {
        default:            switch_bt_4_object;
        purchase:           switch_bt_4_purchase;
        autoslope:          return(CB_RESULT_AUTOSLOPE);
//      additional_text:    string(STR_tallmultipic_1_PURCHASE);
        additional_text:    switch_add_text_STR_bt_4;
	anim_control:    	return CB_RESULT_NEXT_FRAME;
	anim_next_frame: 	return CB_RESULT_NEXT_FRAME;
    }
}
/////////////basic tiles 5/////////////
template template_tallflat_m(x,y,filename) {
    [x+14, y+2, 64, 244, -31, -213, filename]
    [x+89, y+2, 64, 244, -31, -213, filename]
    [x+164, y+2, 64, 244, -31, -213, filename]
    [x+239, y+2, 64, 244, -31, -213, filename]
}

spriteset (spriteset_bt_5) {
    template_tallflat_m(0,0,"gfx/tallflat_8.png")
}
alternative_sprites (spriteset_bt_5, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "") {
    template_tallflat_m(0,0,"gfx/bt_5.png")
}

