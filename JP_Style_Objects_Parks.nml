    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_bt_2_2((animation_frame + nearby_tile_random_bits(0,0)) % 9);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_bt_2_2_snow((animation_frame + nearby_tile_random_bits(0,0)) % 9);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }

}
