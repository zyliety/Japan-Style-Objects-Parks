//OBJECT 1 SIMPLE tallmultipic//
//SPRITELAYOUTS//

//RURAL tallmultipic LOT NE + PURCHASE//
spritelayout spritelayout_path_11_1 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_11_1((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_11_1_snow((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }


}

spritelayout spritelayout_path_11_1_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_11_PURCHASE(0);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//RURAL tallmultipic LOT SE + PURCHASE//
spritelayout spritelayout_path_11_2 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_11_2((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_11_2_snow((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }

}
spritelayout spritelayout_path_11_2_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_11_PURCHASE(1);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//OBJECT 2 SIMPLE tallmultipic//
//tallmultipic LOT NE + PURCHASE//
spritelayout spritelayout_path_11_3 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_11_3((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_11_3_snow((animation_frame + nearby_tile_random_bits(0,0)) % 4);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }

}
spritelayout spritelayout_path_11_3_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_11_PURCHASE(2);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//tallmultipic LOT SE + PURCHASE//
spritelayout spritelayout_path_11_4 {
    ground {
        sprite: LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_11_4((animation_frame + nearby_tile_random_bits(0,0)) % 5);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_11_4_snow((animation_frame + nearby_tile_random_bits(0,0)) % 5);
		xextent: 16;
		yextent: 16;
		zextent: 6;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }

}
spritelayout spritelayout_path_11_4_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_11_PURCHASE(3);
		xextent: 16;
		yextent: 16;
		zextent: 6;
    }

}

//decide spritelayout for each of the 4 views
switch (FEAT_OBJECTS, SELF, switch_path_11_view, view) {
    1:  spritelayout_path_11_2;
    2:  spritelayout_path_11_3;
    3:  spritelayout_path_11_4;
    spritelayout_path_11_1;
}

//calculate ground sprite for object
switch (FEAT_OBJECTS, SELF, switch_path_11_object, [
        //tile slope offset in storage register 0
        STORE_TEMP(0, 0),
        //terrain type in storage register 1
        STORE_TEMP(GROUNDSPRITE_NORMAL, 1),
		STORE_TEMP( (nearby_tile_terrain_type(0,0) == TILETYPE_DESERT) * GROUNDSPRITE_DESERT, 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 1, 0) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type(-1, 0) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 0, 1) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * 4512 * (nearby_tile_terrain_type( 0,-1) == TILETYPE_DESERT), 1),
		STORE_TEMP( LOAD_TEMP(1) + (LOAD_TEMP(1) == 0) * GROUNDSPRITE_NORMAL, 1),
		STORE_TEMP(terrain_type == TILETYPE_SNOW   ? GROUNDSPRITE_SNOW : LOAD_TEMP(1), 1),
		STORE_TEMP(snowline_height == 0xFF ? 0xFF : nearby_tile_height(0,0) - snowline_height, 127),
		STORE_TEMP((LOAD_TEMP(127) == -1) ? GROUNDSPRITE_SNOW_1_4 : LOAD_TEMP(1), 1),
		STORE_TEMP((LOAD_TEMP(127) ==  0) ? GROUNDSPRITE_SNOW_2_4 : LOAD_TEMP(1), 1),
		STORE_TEMP((LOAD_TEMP(127) ==  1) ? GROUNDSPRITE_SNOW_3_4 : LOAD_TEMP(1), 1)
        ]) {
    switch_path_11_view;
}

//decide spritelayout for the purchase menu
switch (FEAT_OBJECTS, SELF, switch_path_11_purchase, view) {
    1:  spritelayout_path_11_2_purchase;
    2:  spritelayout_path_11_3_purchase;
    3:  spritelayout_path_11_4_purchase;
    spritelayout_path_11_1_purchase;
}

switch (FEAT_OBJECTS, SELF, switch_add_text_STR_path_11, view) {
1: string(STR_path_11_purchase_view2);
2: string(STR_path_11_purchase_view3);
3: string(STR_path_11_purchase_view4);
default: string(STR_path_11_purchase_view1);
}

item (FEAT_OBJECTS, item_path_11, 211) {
    property {
        class:                  "PAHH";
	classname:		string(STR_PAHH);
        name:                   string(STR_path_11);
        climates_available:     ALL_CLIMATES;
        size:                   [1,1];
        build_cost_multiplier:  0;
        remove_cost_multiplier: 0;
        introduction_date:      date(1111,1,1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           bitmask(OBJ_FLAG_ANYTHING_REMOVE);
//	animation_info:			[ANIMATION_LOOPING, 9];
//	animation_speed:		7;
//	animation_triggers:		3;
        height:                 1;
        num_views:              4;
    }
    graphics {
        default:            switch_path_11_object;
        purchase:           switch_path_11_purchase;
        autoslope:          return(CB_RESULT_AUTOSLOPE);
//      additional_text:    string(STR_tallmultipic_1_PURCHASE);
        additional_text:    switch_add_text_STR_path_11;
	anim_control:    	return CB_RESULT_NEXT_FRAME;
	anim_next_frame: 	return CB_RESULT_NEXT_FRAME;
    }
}
////////natural tiles 1///////////
template template_slopes_NT(x,y) {
    [   0, y, 64, 31, -31,   0, ANIM]
    [  80, y, 64, 31, -31,   0, ANIM]
    [ 160, y, 64, 23, -31,   0, ANIM]
    [ 240, y, 64, 23, -31,   0, ANIM]
    [ 320, y, 64, 31, -31,   0, ANIM]
    [ 400, y, 64, 31, -31,   0, ANIM]
    [ 480, y, 64, 23, -31,   0, ANIM]
    [ 560, y, 64, 23, -31,   0, ANIM]
    [ 640, y, 64, 39, -31,  -8, ANIM]
    [ 720, y, 64, 39, -31,  -8, ANIM]
    [ 800, y, 64, 31, -31,  -8, ANIM]
    [ 880, y, 64, 31, -31,  -8, ANIM]
    [ 960, y, 64, 39, -31,  -8, ANIM]
    [1040, y, 64, 39, -31,  -8, ANIM]
    [1120, y, 64, 31, -31,  -8, ANIM]
    [1200, y, 64, 47, -31, -16, ANIM]
    [1280, y, 64, 15, -31,   0, ANIM]
    [1360, y, 64, 31, -31,  -8, ANIM]
    [1440, y, 64, 31, -31,  -8, ANIM]
}

spriteset(spriteset_cannatile11, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/cannatile11_auto-slope.png") { template_slopes_NT(0,0) }
spriteset(spriteset_cannatile11_coast, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/cannatile11_auto-slope.png") { template_slopes_NT(0,50) }
spriteset(spriteset_cannatile11_water, "gfx/cannatile11_auto-slope_water.png") { template_slopes_NT(0,0) }
spritelayout layout_cannatile11 { ground { sprite: spriteset_cannatile11(LOAD_TEMP(0)); } }
spritelayout layout_cannatile11_coast { 
    ground { sprite: 4061; }
    childsprite { sprite: spriteset_cannatile11_coast(LOAD_TEMP(0)); }
    childsprite { sprite: spriteset_cannatile11_water(LOAD_TEMP(0)); } }
spritelayout layout_cannatile11_menu  { ground { sprite: spriteset_cannatile11(0); } }

// check for water class to select coast sprites
switch (FEAT_OBJECTS, SELF, switch_cannatile11_coast, [
    (LOAD_TEMP(0) == 0  && nearby_tile_water_class(0, 0))  || // flat
    (LOAD_TEMP(0) == 3  && nearby_tile_water_class(-1, 0)) || // two raised corners
    (LOAD_TEMP(0) == 6  && nearby_tile_water_class(0, -1)) ||
    (LOAD_TEMP(0) == 9  && nearby_tile_water_class(0, 1))  ||
    (LOAD_TEMP(0) == 12 && nearby_tile_water_class(1, 0))  ||
    (LOAD_TEMP(0) == 1  && (nearby_tile_water_class(-1, 0) || nearby_tile_water_class(0, 1)))  || // one raised corner
    (LOAD_TEMP(0) == 2  && (nearby_tile_water_class(-1, 0) || nearby_tile_water_class(0, -1))) ||
    (LOAD_TEMP(0) == 4  && (nearby_tile_water_class(1, 0)  || nearby_tile_water_class(0, -1))) ||
    (LOAD_TEMP(0) == 8  && (nearby_tile_water_class(1, 0)  || nearby_tile_water_class(0, 1)))
]) {
    1: layout_cannatile11_coast;
    layout_cannatile11;
}

switch (FEAT_OBJECTS, SELF, switch_cannatile11, [STORE_TEMP(slope_to_sprite_offset(tile_slope), 0)]) { switch_cannatile11_coast; }
switch (FEAT_OBJECTS, SELF, switch_cannatile11_view, view) { 0: switch_cannatile11; }
switch (FEAT_OBJECTS, SELF, switch_cannatile11_menu, view) { 0: layout_cannatile11_menu; }

item (FEAT_OBJECTS, item_cannatile11, 300){
    property {
        class:                  "NAST";
        classname:              string(STR_NAST);
        name:                   string(STR_cannatile11);
        climates_available:     ALL_CLIMATES;
        size:                   [1,1];
        build_cost_multiplier:  0;
        remove_cost_multiplier: 0;
        introduction_date:      0x00000000;
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           bitmask(OBJ_FLAG_ANYTHING_REMOVE, OBJ_FLAG_NO_FOUNDATIONS, OBJ_FLAG_ALLOW_BRIDGE, OBJ_FLAG_ON_WATER);
        height:                 0;
        num_views:              1;
    }
    graphics {
        default:    switch_cannatile11_view;
        purchase:   switch_cannatile11_menu;
        tile_check: return CB_RESULT_LOCATION_ALLOW;
        autoslope:  return CB_RESULT_AUTOSLOPE;
    }
}
