    template_tallmultipic_purchase(0,0,"gfx/path_8_PURCHASE.png")
}



spritelayout spritelayout_path_8_01 {
    ground {
        sprite: LOAD_TEMP(0) + LOAD_TEMP(1);
	}

	building {
        sprite: spriteset_path_8_1((animation_frame + nearby_tile_random_bits(0,0)) % 4);
        	xoffset: 0; //from NE edge
        	yoffset: 0; //from NW edge
		xextent: 16;
		yextent: 16;
		zextent: 16;
		hide_sprite: (terrain_type == TILETYPE_SNOW);
    }
	building {
        sprite: spriteset_path_8_1_snow((animation_frame + nearby_tile_random_bits(0,0)) % 4);
        	xoffset: 0; //from NE edge
        	yoffset: 0; //from NW edge
		xextent: 16;
		yextent: 16;
		zextent: 16;
		hide_sprite: (terrain_type != TILETYPE_SNOW);
    }


}

spritelayout spritelayout_path_8_01_purchase {
    ground {
        sprite: GROUNDSPRITE_NORMAL;
	}

	building {
        sprite: spriteset_path_8_PURCHASE(0);
        	xoffset: 0; //from NE edge
        	yoffset: 0; //from NW edge
		xextent: 16;
		yextent: 16;
		zextent: 16;
    }

}

